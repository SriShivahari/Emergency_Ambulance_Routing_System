# .gitignore

```gitignore
# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/

# Environment variables
.env

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Build files
build/
dist/
*.egg-info/

# Logs
*.log

# IDE files
.vscode/
.idea/
.cursor/

# OS files
.DS_Store
Thumbs.db

# Model files
*.pkl
*.joblib

# Temporary files
*.tmp
*.temp

# Generated datasets
*.csv

# Flask cache
instance/
.webassets-cache/

# Pytest
.pytest_cache/

# Coverage reports
.coverage
htmlcov/

# Uploaded files
uploads/

# Local database files
*.sqlite3